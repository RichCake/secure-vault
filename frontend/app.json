{
    "expo": {
        "scheme": "react-native-test",
        "name": "secure-vault",
        "slug": "secure-vault",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/img/vault-2.png",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/img/vault-2.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "richcake-securevault"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/img/vault-2.png",
                "backgroundColor": "#ffffff"
            },
            "edgeToEdgeEnabled": true,
            "package": "com.richcake.securevault",
            "usesCleartextTraffic": true
        },
        "web": {
            "bundler": "metro",
            "favicon": "./assets/img/vault-2.png"
        },
        "extra": {
            "eas": {
                "projectId": "31857379-437c-4f34-bce4-87586c68ea2e"
            }
        },
        "owner": "richcake",
        "plugins": [
            "expo-router",
            "expo-font",
            [
                "expo-build-properties",
                {
                    "android": {
                        "usesCleartextTraffic": true
                    }
                }
            ]
        ]
    }
}